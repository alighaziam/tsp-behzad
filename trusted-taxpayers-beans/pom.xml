<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>ir.tax</groupId>
    <artifactId>trusted-taxpayers-beans</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <parent>
        <groupId>ir.tax</groupId>
        <artifactId>trusted-taxpayers-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../trusted-taxpayers-parent/pom.xml</relativePath>
    </parent>
    <distributionManagement>
        <repository>
            <id>central</id>
            <name>app-test-server-releases</name>
            <url>http://172.16.200.35:8081/repository/libs-snapshot-local/</url>
        </repository>
        <snapshotRepository>
            <id>snapshots</id>
            <name>app-test-server-snapshots</name>
            <url>http://172.16.200.35:8081/repository/libs-snapshot-local/</url>
        </snapshotRepository>
    </distributionManagement>
    <build>
        <defaultGoal>install</defaultGoal>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>${java.version}</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <dependencies>
        <!-- Tax Collect Data SDK Dependencies -->
        <dependency>
            <groupId>ir.tax.sdk</groupId>
            <artifactId>content</artifactId>
            <version>${tax.sdk.version}</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/../java/content-${tax.sdk.version}.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>ir.tax.sdk</groupId>
            <artifactId>transfer</artifactId>
            <version>${tax.sdk.version}</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/../java/transfer-${tax.sdk.version}.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>ir.tax.sdk</groupId>
            <artifactId>utils</artifactId>
            <version>${tax.sdk.version}</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/../java/utils-${tax.sdk.version}.jar</systemPath>
        </dependency>
        
        <!-- Jakarta Validation API -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>
        
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- Jackson for JSON annotations -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>
        
        <!-- Core module for BaseDto -->
        <dependency>
            <groupId>ir.tax</groupId>
            <artifactId>trusted-taxpayers-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-models-jakarta</artifactId>
            <version>2.2.28</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations-jakarta</artifactId>
            <version>2.2.28</version>
            <scope>compile</scope>
        </dependency>
    </dependencies>
</project>

