# Copy to .env and replace every placeholder with real deployment values.
# Never commit .env or real private keys.
APP_DB_URL=jdbc:oracle:thin:@oracle-db:1521/YOUR_PDB_SERVICE
APP_DB_USER=YOUR_APP_SCHEMA
APP_DB_PASSWORD=REPLACE_ME
APP_JWT_SECRET=BASE64_ENCODED_RANDOM_SECRET_AT_LEAST_32_BYTES
ORACLE_PWD=REPLACE_ME
OAUTH2_CLIENT_ID=trusted-taxpayers-client
OAUTH2_CLIENT_SECRET=REPLACE_ME
OAUTH2_ISSUER_URI=https://your-identity-provider.example/issuer
OAUTH2_JWK_SET_URI=https://your-identity-provider.example/.well-known/jwks.json
TAX_SDK_BASE_URL=https://tp.tax.gov.ir/requestsmanager/api/self-tsp
TAX_SDK_MEMORY_ID=YOUR_REGISTERED_MEMORY_ID
TAX_SDK_CLIENT_ID=YOUR_REGISTERED_TSP_CLIENT_ID
TAX_SDK_PRIVATE_KEY_FILE=/absolute/path/to/private.pem
TAX_SDK_PRIVATE_KEY_PASSWORD=
TAXPAYER_SYSTEM_URL=https://your-taxpayer-system.example
TAX_CLIENT_ID=YOUR_TAX_CLIENT_ID
TAX_ORG_KEY_ID=YOUR_ORGANIZATION_KEY_ID
TAX_ORG_PUBLIC_KEY=YOUR_ORGANIZATION_PUBLIC_KEY
CORS_ALLOWED_ORIGINS=https://your-frontend.example
