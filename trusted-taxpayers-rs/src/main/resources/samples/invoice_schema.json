{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Invoice Import Schema",
  "type": "object",
  "properties": {
    "invoices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["invoiceNumber", "issueDate", "sellerTaxId", "currency", "items"],
        "properties": {
          "invoiceNumber": { "type": "string", "minLength": 1 },
          "issueDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "sellerTaxId": { "type": "string", "minLength": 5, "maxLength": 20 },
          "buyerTaxId": { "type": "string" },
          "currency": { "type": "string", "enum": ["IRR", "IRT", "USD", "EUR"] },
          "totalAmount": { "type": "number", "minimum": 0 },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["itemName", "itemQty", "itemUnitPrice"],
              "properties": {
                "itemName": { "type": "string", "minLength": 1 },
                "itemQty": { "type": "number", "minimum": 0 },
                "itemUnitPrice": { "type": "number", "minimum": 0 }
              }
            }
          }
        }
      }
    }
  },
  "required": ["invoices"]
}


